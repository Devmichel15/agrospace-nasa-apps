# URL base da API. Deixe vazio para usar o proxy de desenvolvimento (/api).
# Em produção, aponte para o backend publicado, sem barra final.
VITE_API_URL=

# Destino do proxy de desenvolvimento (npm run dev).
VITE_PROXY_TARGET=http://127.0.0.1:8000

# Endereço do ESP32 na rede local (usado pelo proxy /esp em desenvolvimento).
VITE_ESP_URL=http://192.168.0.216

# Caminho que devolve o JSON no ESP32 (normalmente "/").
VITE_ESP_ENDPOINT=/
